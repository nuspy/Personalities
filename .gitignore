/build
/venv/
/venv_corrupt_backup/
/.venv/
/hu_core_news_trf-3.7.0-py3-none-any.whl
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# I progetti generati sono output, non sorgente.
/historical_persona_pipeline/projects/
/historical_persona_pipeline/cache/
# Cache di compilazione generata da Unsloth all'avvio dell'addestramento.
/unsloth_compiled_cache/
# Gli artefatti delle realizzazioni: pesi, adapter, GGUF.
#
# Ancorata alla radice. Senza la barra iniziale la regola vale a ogni
# livello e si porta via anche `platform_core/builds/` — il pacchetto del
# worker, coda e runner compresi — che sparirebbe dalla versione senza che
# nessuno se ne accorga finché non serve ripristinarlo.
/builds/
/artifacts/

# I file caricati dalla console in attesa del worker: copie di documenti
# altrui, non sorgenti del progetto.
data/caricamenti/

# I segreti degli ambienti Kubernetes: si generano dagli esempi, non si committano.
deploy/k8s/overlays/*/segreti.env
deploy/k8s/overlays/*/keycloak.env

# Il kubeconfig del cluster di prova locale.
deploy/k8s/.kube-locale*.yaml

# La documentazione commerciale e tecnica resta fuori dal repository.
# `docs/` contiene la proposta con il nome del cliente e il prezzo netto,
# e il generatore che li produce: non hanno motivo di vivere nella storia
# di un repository che un giorno potrebbe essere condiviso o reso pubblico.
# I file restano sulla macchina; i documenti si rigenerano con
# `node docs/generator/build_en.js` e `build_hu.js`.
/docs/
