# Copiare in segreti.env (ignorato da git) e compilare. Genera il Secret
# persona-segreti. La password in PERSONA_DATABASE_URL è POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
PERSONA_DATABASE_URL=postgresql+psycopg://persona:POSTGRES_PASSWORD@postgres:5432/persona
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Solo con PERSONA_LLM_PROVIDER=anthropic, o per un endpoint compatibile con chiave.
PERSONA_ANTHROPIC_API_KEY=
PERSONA_LLM_API_KEY=non-serve-in-locale
# Solo quando ci sarà un fornitore di pagamento vero.
PERSONA_BILLING_WEBHOOK_SECRET=
