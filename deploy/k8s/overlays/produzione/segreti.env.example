# Copiare in segreti.env (ignorato da git) e compilare. Genera il Secret
# persona-segreti. La password in PERSONA_DATABASE_URL è POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
PERSONA_DATABASE_URL=postgresql+psycopg://persona:POSTGRES_PASSWORD@postgres:5432/persona
KEYCLOAK_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Solo con PERSONA_LLM_PROVIDER=anthropic, o per un endpoint compatibile con chiave.
PERSONA_ANTHROPIC_API_KEY=
PERSONA_LLM_API_KEY=non-serve-in-locale
# Solo quando ci sarà un fornitore di pagamento vero.
PERSONA_BILLING_WEBHOOK_SECRET=

# --- accensione a richiesta del motore locale (facoltativa) ---------------
# Comandi che il worker esegue per accendere e spegnere il modello sulla
# macchina che lo ospita. Stanno fra i segreti e non nella ConfigMap perché
# contengono l'indirizzo della macchina nel tailnet, e perché nessuno deve
# poterli cambiare senza i diritti di modificare un Secret: sono comandi
# eseguiti dal worker.
#
# La chiave è **a comando forzato** sulla macchina dei modelli: in
# authorized_keys la riga porta
#   command="C:\percorso\start.ps1",no-port-forwarding,no-agent-forwarding,
#   no-X11-forwarding,no-pty,from="<IP/32 dell'egress del cluster>"
# e una chiave diversa per accendere e per spegnere. Così qualunque cosa il
# worker mandi, quella chiave può fare solo quella cosa — e solo da lì.
# Lasciarli vuoti: il modello si gestisce a mano, come oggi.
PERSONA_LOCAL_ENGINE_START=
PERSONA_LOCAL_ENGINE_STOP=
# Dove si chiede se è pronto. Senza, l'accensione si fida dell'uscita del
# comando, che dice se è partito — non se risponde.
PERSONA_LOCAL_ENGINE_HEALTH_URL=
# Quanto attendere il caricamento del modello, e dopo quanta inattività
# spegnerlo. Zero come inattività: non si spegne da solo.
PERSONA_LOCAL_ENGINE_WAIT_S=180
PERSONA_LOCAL_ENGINE_IDLE_S=900
