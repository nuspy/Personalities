# Copiare in ricerca.env (ignorato da git) e compilare. Genera il Secret
# `ricerca-segreti`, usato dai container della ricerca online.
#
# Sono segreti interni: nessuno dei due protegge qualcosa che arriva da
# fuori, perche' quei servizi non sono raggiungibili dall'esterno. Restano
# segreti perche' una password di database e una chiave di sessione scritte
# in chiaro in una ConfigMap sono il genere di cosa che si copia altrove.

# La password del Postgres che tiene lo stato della coda di Firecrawl.
POSTGRES_PASSWORD=

# La chiave con cui SearXNG firma le proprie sessioni. Una stringa casuale
# lunga: `openssl rand -hex 32`.
SEARXNG_SECRET=
