# Immagine unica per API e worker: cambia il comando, non il contenuto.
# Lo stesso codice serve le richieste e le esegue, e avere due immagini
# significherebbe poterle disallineare.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Dipendenze prima del codice: cambiano di rado, e così il livello resta in
# cache fra una build e l'altra.
COPY pyproject.toml ./
COPY deploy/requirements-backend.txt ./
RUN pip install --no-cache-dir -r requirements-backend.txt

COPY platform_core ./platform_core

# Utente non privilegiato: un processo che non deve scrivere sul filesystem
# dell'immagine non deve poterlo fare.
RUN useradd --create-home --uid 1000 persona && chown -R persona:persona /app
USER persona

EXPOSE 8000

# La liveness non tocca i supporti: un database lento non deve far riavviare
# un'applicazione sana.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"

CMD ["uvicorn", "platform_core.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
